{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 31,
        "patch": 0
    },

    "configurePresets": [
        {
            "name": "base-config",
            "hidden": true,
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_PREFIX_PATH": "${sourceDir}/.local",
                "IDK_CONTENT_BASEPATH": "content"
            }
        },
        {
            "name": "debug",
            "inherits": "base-config",
            "binaryDir": "${sourceDir}/build-debug/cmake",
            "installDir": "${sourceDir}/build-debug/idkge",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "release",
            "inherits": "base-config",
            "binaryDir": "${sourceDir}/build-release/cmake",
            "installDir": "${sourceDir}/build-release/idkge",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],

    "buildPresets": [
        {
            "name": "debug",
            "configurePreset": "debug"
        },
        {
            "name": "release",
            "configurePreset": "release"
        }
    ]
}
